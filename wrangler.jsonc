{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skilld-dev",
  "account_id": "5904138d55ca25d5670dca6adf99894e",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 300000
  },
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "skilld-db", "database_id": "a5e53f35-f5e5-4987-8c67-c0175addc7cc" }
  ],
  "kv_namespaces": [
    { "binding": "KV_CACHE", "id": "187e636458cb49faa2ae14743adc7736" },
    { "binding": "KV_DATA", "id": "cf3d794a55f84192a30f520686e1d932" },
    // Versioned build assets for nuxt-skew-protection: serves old hashed chunks
    // to clients on a previous deployment so they never 404 (Sentry SKILLD-4).
    { "binding": "SKEW_PROTECTION", "id": "399c1b7cc7994c31a5e9abc7e65b2bea" }
  ],
  "analytics_engine_datasets": [
    { "binding": "SKILLD_ANALYTICS", "dataset": "skilld_cli_v1" }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vectorize": [
    { "binding": "SKILL_EMBEDDINGS", "index_name": "skill-embeddings", "remote": true }
  ],
  "migrations": [
    { "tag": "v1", "new_classes": ["$DurableObject"] },
    { "tag": "v2", "deleted_classes": ["$DurableObject"] }
  ],
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "routes": [
    {
      "pattern": "skilld.dev",
      "custom_domain": true
    }
  ]
}
