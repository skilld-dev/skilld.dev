{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skilld-dev",
  "account_id": "5904138d55ca25d5670dca6adf99894e",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "limits": {
    "cpu_ms": 300000
  },
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "skilld-db", "database_id": "a5e53f35-f5e5-4987-8c67-c0175addc7cc" }
  ],
  "kv_namespaces": [
    { "binding": "KV_CACHE", "id": "187e636458cb49faa2ae14743adc7736" },
    { "binding": "KV_DATA", "id": "cf3d794a55f84192a30f520686e1d932" }
  ],
  "analytics_engine_datasets": [
    { "binding": "SKILLD_ANALYTICS", "dataset": "skilld_cli_v1" }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "queues": {
    "producers": [
      { "binding": "REPO_SYNC_QUEUE", "queue": "skilld-repo-sync" },
      { "binding": "REPO_REVIEW_SYNC_QUEUE", "queue": "skilld-repo-review-sync" },
      { "binding": "REPO_SYNC_DLQ", "queue": "skilld-repo-sync-dlq" }
    ],
    // `max_retries` here is a *delivery* budget, not a failure budget. The repo
    // sync handler releases the message back to the queue after every 50-file
    // slice, so one large repository spends many deliveries while succeeding.
    // At `max_retries: 3` a repo hard-stopped after 4 deliveries, i.e. 200
    // SKILL.md files, then dead-lettered on every hourly tick forever. Measured
    // 2026-08-16: six repositories sat at `repo_sync_progress.next_offset = 200`
    // against 236 to 6,341 skills, producing 548 dead-letter rows in four days.
    // The failure budget is the job definition's own `tries: 5`, checked against
    // `jobs.attempts` before the message is ever allowed to reach the DLQ, so
    // raising this does not weaken failure handling. It also stops the DLQ
    // headline replacing the real exception in `failed_jobs`, which it did
    // whenever a throwing job hit 4 deliveries before it hit 5 attempts.
    "consumers": [
      {
        "queue": "skilld-repo-sync",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 100,
        "retry_delay": 60,
        "dead_letter_queue": "skilld-repo-sync-dlq",
        "max_concurrency": 1
      },
      {
        "queue": "skilld-repo-review-sync",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 100,
        "retry_delay": 60,
        "dead_letter_queue": "skilld-repo-sync-dlq",
        "max_concurrency": 5
      },
      {
        "queue": "skilld-repo-sync-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 60,
        "max_concurrency": 1
      }
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@mail.skilld.dev"]
    }
  ],
  // Self binding for the daily health check's front-door probe. A plain
  // fetch('https://skilld.dev/') from inside this Worker leaves the runtime and
  // comes back 522, which pinned the operator email RED while real traffic was
  // fine. SELF.fetch dispatches straight to this Worker's fetch handler, so the
  // probe measures whether the app still renders instead of the loopback path.
  "services": [
    { "binding": "SELF", "service": "skilld-dev" }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vectorize": [
    { "binding": "SKILL_EMBEDDINGS", "index_name": "skill-embeddings", "remote": true }
  ],
  "migrations": [
    { "tag": "v1", "new_classes": ["$DurableObject"] },
    { "tag": "v2", "deleted_classes": ["$DurableObject"] }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "routes": [
    {
      "pattern": "skilld.dev",
      "custom_domain": true
    }
  ]
}
