{
  "name": "skilld-dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "description": "Agent skills written by real maintainers in their own GitHub repos, with links to source",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi prepare && nuxi build",
    "preview": "nuxi preview",
    "dev:prepare": "nuxt prepare",
    "perf:cold-start": "node scripts/tools/measure-nitro-cold-start.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "wrangler types --check --config wrangler.jsonc --env-file .dev.vars.example && nuxt typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "pnpm build:test && playwright test",
    "test:e2e:update": "pnpm build:test && playwright test --update-snapshots",
    "build:test": "NODE_ENV=test nuxi build",
    "seo:audit-supported": "npx tsx scripts/audit-supported-indexable-skills.ts",
    "seo:curate-supported": "npx tsx scripts/curate-supported-source.ts",
    "embeddings:parity": "tsx scripts/check-embedding-parity.ts",
    "production:deploy": "tsx scripts/deploy-production.ts",
    "production:smoke": "tsx scripts/check-production-smoke.ts",
    "production:edge-cache": "tsx scripts/check-edge-cache.ts",
    "registry:convergence": "tsx scripts/check-registry-convergence.ts",
    "crawl:skills-sh": "tsx scripts/crawl-skills-sh.ts",
    "db:schema:verify": "tsx scripts/verify-d1-schema.ts",
    "cron:docs": "tsx scripts/generate-cron-docs.ts --write",
    "cron:docs:check": "tsx scripts/generate-cron-docs.ts --check",
    "cron:parity": "tsx scripts/check-schedule-parity.ts",
    "design:eyebrows": "tsx scripts/check-eyebrows.ts",
    "cli:grammar": "tsx scripts/check-published-cli-grammar.ts",
    "start:playwright:webserver": "wrangler d1 migrations apply DB --local --config wrangler.jsonc && NODE_ENV=test wrangler dev --config .output/server/wrangler.json --persist-to .wrangler/state --port 5678",
    "db:migrations:dev": "wrangler d1 migrations apply DB --local",
    "db:migrations:prod": "wrangler d1 migrations apply DB --remote",
    "checkin": "nuxt-checkin prepare && nuxt-checkin"
  },
  "dependencies": {
    "@comark/nuxt": "catalog:",
    "@harlan-zw/comark-content": "catalog:",
    "@harlan-zw/nuxt-cf-jobs": "catalog:",
    "@harlan-zw/nuxt-checkin": "catalog:",
    "@harlan-zw/nuxt-use-query": "catalog:",
    "@harlan-zw/nuxt-wide-events": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/simple-icons": "catalog:",
    "@iconify-json/vscode-icons": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@nuxt/fonts": "catalog:",
    "@nuxt/scripts": "catalog:",
    "@nuxt/ui": "catalog:",
    "@nuxtjs/seo": "catalog:",
    "@resvg/resvg-js": "catalog:",
    "@sentry/cloudflare": "catalog:",
    "@sentry/nuxt": "catalog:",
    "@takumi-rs/core": "catalog:",
    "@takumi-rs/wasm": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/nuxt": "catalog:",
    "agents": "catalog:",
    "comark": "catalog:",
    "h3": "catalog:",
    "import-in-the-middle": "catalog:",
    "marked": "catalog:",
    "motion-v": "catalog:",
    "nuxt": "catalog:",
    "nuxt-ai-ready": "catalog:",
    "nuxt-auth-utils": "catalog:",
    "nuxt-og-image": "catalog:",
    "rangi": "catalog:",
    "skilld-protocol": "catalog:",
    "tailwindcss": "catalog:",
    "unstorage": "catalog:",
    "vue": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@harlan-zw/nuxt-cloudflare": "catalog:",
    "@harlan-zw/nuxt-dx": "catalog:",
    "@harlan-zw/nuxt-sentry": "catalog:",
    "@nuxt/a11y": "catalog:",
    "@nuxt/eslint": "catalog:",
    "@nuxt/kit": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxtjs/html-validator": "catalog:",
    "@nuxtjs/mcp-toolkit": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@vue/test-utils": "catalog:",
    "axe-core": "catalog:",
    "better-sqlite3": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-harlanzw": "catalog:",
    "happy-dom": "catalog:",
    "lint-staged": "catalog:",
    "nuxt-skew-protection": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "wrangler": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,vue}": [
      "pnpm exec eslint --fix"
    ]
  }
}
