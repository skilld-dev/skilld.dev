{
  "name": "skilld-dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Curated agent skills from trusted open-source developers",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi prepare && nuxi build",
    "preview": "nuxi preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "pnpm build:test && playwright test",
    "test:e2e:update": "pnpm build:test && playwright test --update-snapshots",
    "build:test": "NODE_ENV=test nuxi build",
    "start:playwright:webserver": "NODE_ENV=test nuxi preview --port 5678"
  },
  "dependencies": {
    "@atproto/api": "catalog:",
    "@atproto/common": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/simple-icons": "catalog:",
    "@nuxt/fonts": "catalog:",
    "@nuxt/scripts": "catalog:",
    "@nuxt/ui": "catalog:",
    "@nuxtjs/seo": "catalog:",
    "@resvg/resvg-js": "catalog:",
    "@takumi-rs/core": "catalog:",
    "@takumi-rs/wasm": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/nuxt": "catalog:",
    "algoliasearch": "catalog:",
    "atproto-oauth-client-cloudflare-workers": "catalog:",
    "marked": "catalog:",
    "motion-v": "catalog:",
    "nuxt": "catalog:",
    "nuxt-og-image": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@nuxt/a11y": "catalog:",
    "@nuxt/eslint": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxtjs/html-validator": "catalog:",
    "@playwright/test": "catalog:",
    "@vue/test-utils": "catalog:",
    "axe-core": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-harlanzw": "catalog:",
    "happy-dom": "catalog:",
    "lint-staged": "catalog:",
    "nitro-cloudflare-dev": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "wrangler": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,vue}": [
      "pnpm exec eslint --fix"
    ]
  }
}
