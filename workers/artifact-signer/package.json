{
  "name": "@skilld/artifact-signer-worker",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "wrangler deploy --dry-run --config wrangler.jsonc --outdir dist",
    "deploy:production": "wrangler deploy --config wrangler.jsonc",
    "lint": "eslint src test",
    "typecheck": "site-typecheck --noEmit --incremental false",
    "types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc --env-file .dev.vars.example --env-interface ArtifactSignerEnv",
    "types:check": "wrangler types worker-configuration.d.ts --config wrangler.jsonc --env-file .dev.vars.example --env-interface ArtifactSignerEnv --check",
    "test:worker": "vitest run --config vitest.config.ts",
    "typecheck:legacy": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "eslint": "catalog:",
    "site-typecheck": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
