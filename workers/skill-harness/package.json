{
  "name": "@skilld/skill-harness-worker",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:proof": "wrangler deploy --containers-rollout immediate",
    "types": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example --env-interface HarnessEnv --include-runtime=false",
    "types:check": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example --env-interface HarnessEnv --include-runtime=false --check",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run --config vitest.config.ts",
    "lint": "eslint src test runner"
  },
  "dependencies": {
    "@cloudflare/sandbox": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:harness",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:harness"
  }
}
