{
  "lexicon": 1,
  "id": "dev.skilld.collection.save",
  "defs": {
    "main": {
      "type": "record",
      "description": "A private bookmark of a collection. Stored in the user's AT Protocol repository.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": {
            "type": "ref",
            "ref": "#subjectRef",
            "description": "Reference to the saved collection."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp when the collection was saved."
          }
        }
      }
    },
    "subjectRef": {
      "type": "object",
      "description": "Reference to a collection by its AT URI and CID.",
      "required": ["uri", "cid"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT URI of the collection record."
        },
        "cid": {
          "type": "string",
          "description": "CID of the collection at time of save."
        }
      }
    }
  }
}
